<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/settingsHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56.0dp"
        android:orientation="horizontal"
        android:paddingLeft="4.0dp"
        android:paddingRight="16.0dp">

        <ImageButton
            android:id="@+id/settingsBackButton"
            android:layout_width="48.0dp"
            android:layout_height="48.0dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/Close"
            android:scaleType="centerInside"
            android:src="?android:attr/homeAsUpIndicator"
            android:tint="@color/settings_text_primary" />

        <TextView
            android:id="@+id/settingsTitleText"
            android:layout_width="0.0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8.0dp"
            android:layout_weight="1.0"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/Settings"
            android:textColor="@color/settings_text_primary"
            android:textSize="20.0sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1.0dp"
        android:background="@color/settings_divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0.0dp"
        android:layout_weight="1.0"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@id/SettingsOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@id/LinearLayoutMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="56.0dp"
                android:paddingLeft="16.0dp"
                android:paddingRight="10.0dp">

                <TextView
                    android:id="@id/TextViewMode"
                    android:layout_width="0.0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left|center_vertical"
                    android:layout_marginTop="8.0dp"
                    android:layout_marginBottom="8.0dp"
                    android:layout_weight="1.0"
                    android:text="@string/Calculator_Mode"
                    android:textColor="@color/settings_text_primary"
                    android:textSize="17.0sp" />

                <Spinner
                    android:id="@id/modeSpinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4.0dp"
                    android:layout_marginBottom="4.0dp"
                    android:backgroundTint="@color/settings_accent"
                    android:gravity="right|center_vertical"
                    android:minHeight="48.0dp"
                    android:popupBackground="@drawable/settings_popup_bg" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1.0dp"
                android:background="@color/settings_divider" />

            <LinearLayout
                android:id="@id/LinearLayoutQuickGuide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="56.0dp"
                android:paddingLeft="16.0dp"
                android:paddingRight="16.0dp">

                <TextView
                    android:id="@id/Quick_Guide_TextView"
                    android:layout_width="0.0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left|center_vertical"
                    android:layout_marginTop="8.0dp"
                    android:layout_marginBottom="8.0dp"
                    android:layout_weight="1.0"
                    android:text="@string/Quick_Guide"
                    android:textColor="@color/settings_text_primary"
                    android:textSize="17.0sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1.0dp"
                android:background="@color/settings_divider" />

            <LinearLayout
                android:id="@id/LinearLayout066"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="56.0dp"
                android:paddingLeft="16.0dp"
                android:paddingRight="16.0dp">

                <TextView
                    android:id="@id/TextView6"
                    android:layout_width="0.0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left|center_vertical"
                    android:layout_marginTop="8.0dp"
                    android:layout_marginBottom="8.0dp"
                    android:layout_weight="1.0"
                    android:text="@string/Always_On"
                    android:textColor="@color/settings_text_primary"
                    android:textSize="17.0sp" />

                <Switch
                    android:id="@id/spinner1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48.0dp"
                    android:showText="false"
                    android:switchMinWidth="52.0dp"
                    android:textOff=""
                    android:textOn=""
                    android:thumb="@drawable/settings_switch_thumb"
                    android:track="@drawable/settings_switch_track" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1.0dp"
                android:background="@color/settings_divider" />

            <LinearLayout
                android:id="@id/LinearLayout00"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="56.0dp"
                android:orientation="horizontal"
                android:paddingLeft="16.0dp"
                android:paddingRight="16.0dp">

                <TextView
                    android:id="@id/TextView0"
                    android:layout_width="0.0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left|center_vertical"
                    android:layout_marginTop="8.0dp"
                    android:layout_marginBottom="8.0dp"
                    android:layout_weight="1.0"
                    android:text="@string/Sound"
                    android:textColor="@color/settings_text_primary"
                    android:textSize="17.0sp" />

                <Switch
                    android:id="@id/mySound"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48.0dp"
                    android:showText="false"
                    android:switchMinWidth="52.0dp"
                    android:textOff=""
                    android:textOn=""
                    android:thumb="@drawable/settings_switch_thumb"
                    android:track="@drawable/settings_switch_track" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1.0dp"
                android:background="@color/settings_divider" />

            <LinearLayout
                android:id="@id/LinearLayout033"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="56.0dp"
                android:paddingLeft="16.0dp"
                android:paddingRight="10.0dp">

                <TextView
                    android:id="@id/TextView01"
                    android:layout_width="0.0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left|center_vertical"
                    android:layout_marginTop="8.0dp"
                    android:layout_marginBottom="8.0dp"
                    android:layout_weight="1.0"
                    android:text="@string/Vibration"
                    android:textColor="@color/settings_text_primary"
                    android:textSize="17.0sp" />

                <Spinner
                    android:id="@id/myVibration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4.0dp"
                    android:layout_marginBottom="4.0dp"
                    android:backgroundTint="@color/settings_accent"
                    android:gravity="right|center_vertical"
                    android:minHeight="48.0dp"
                    android:popupBackground="@drawable/settings_popup_bg" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1.0dp"
                android:background="@color/settings_divider" />

            <LinearLayout
                android:id="@id/LinearLayout044"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="56.0dp"
                android:paddingLeft="16.0dp"
                android:paddingRight="10.0dp">

                <TextView
                    android:id="@id/TextView03"
                    android:layout_width="0.0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left|center_vertical"
                    android:layout_marginTop="8.0dp"
                    android:layout_marginBottom="8.0dp"
                    android:layout_weight="1.0"
                    android:text="@string/Lock_Current_View"
                    android:textColor="@color/settings_text_primary"
                    android:textSize="17.0sp" />

                <Spinner
                    android:id="@id/myCurrentView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4.0dp"
                    android:layout_marginBottom="4.0dp"
                    android:backgroundTint="@color/settings_accent"
                    android:gravity="right|center_vertical"
                    android:minHeight="48.0dp"
                    android:popupBackground="@drawable/settings_popup_bg" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1.0dp"
                android:background="@color/settings_divider" />

            <LinearLayout
                android:id="@id/LinearLayout055"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="56.0dp"
                android:paddingLeft="16.0dp"
                android:paddingRight="16.0dp">

                <TextView
                    android:id="@id/Swap_Decimal_Separator_TextView"
                    android:layout_width="0.0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left|center_vertical"
                    android:layout_marginTop="8.0dp"
                    android:layout_marginBottom="8.0dp"
                    android:layout_weight="1.0"
                    android:text="@string/Swap_Decimal_Separator"
                    android:textColor="@color/settings_text_primary"
                    android:textSize="17.0sp" />

                <Switch
                    android:id="@id/DecimalSwap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48.0dp"
                    android:showText="false"
                    android:switchMinWidth="52.0dp"
                    android:textOff=""
                    android:textOn=""
                    android:thumb="@drawable/settings_switch_thumb"
                    android:track="@drawable/settings_switch_track" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1.0dp"
                android:background="@color/settings_divider" />

            <LinearLayout
                android:id="@id/LinearLayoutReset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="56.0dp"
                android:paddingLeft="16.0dp"
                android:paddingRight="16.0dp">

                <TextView
                    android:id="@id/Reset_TextView"
                    android:layout_width="0.0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left|center_vertical"
                    android:layout_marginTop="8.0dp"
                    android:layout_marginBottom="8.0dp"
                    android:layout_weight="1.0"
                    android:text="@string/Reset_Calculator"
                    android:textColor="@color/settings_text_primary"
                    android:textSize="17.0sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1.0dp"
                android:background="@color/settings_divider" />

            <LinearLayout
                android:id="@+id/LinearLayoutAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="56.0dp"
                android:paddingLeft="16.0dp"
                android:paddingRight="16.0dp">

                <TextView
                    android:id="@+id/About_TextView"
                    android:layout_width="0.0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left|center_vertical"
                    android:layout_marginTop="8.0dp"
                    android:layout_marginBottom="8.0dp"
                    android:layout_weight="1.0"
                    android:textColor="@color/settings_text_primary"
                    android:textSize="17.0sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1.0dp"
                android:background="@color/settings_divider" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
