<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quickGuideRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/quickGuideHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56.0dp"
        android:orientation="horizontal"
        android:paddingLeft="4.0dp"
        android:paddingRight="16.0dp">

        <ImageButton
            android:id="@+id/quickGuideBackButton"
            android:layout_width="48.0dp"
            android:layout_height="48.0dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/Close"
            android:scaleType="centerInside"
            android:src="?android:attr/homeAsUpIndicator"
            android:tint="@color/settings_text_primary" />

        <TextView
            android:id="@+id/quickGuideTitleText"
            android:layout_width="0.0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8.0dp"
            android:layout_weight="1.0"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/Quick_Guide"
            android:textColor="@color/settings_text_primary"
            android:textSize="20.0sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1.0dp"
        android:background="@color/settings_divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0.0dp"
        android:layout_weight="1.0"
        android:background="#ff000000"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@id/backCoverImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:maxWidth="520.0dp"
                android:src="@drawable/cc12cpt_back" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
