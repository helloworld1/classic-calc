<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aboutRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/aboutHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56.0dp"
        android:orientation="horizontal"
        android:paddingLeft="4.0dp"
        android:paddingRight="16.0dp">

        <ImageButton
            android:id="@+id/aboutBackButton"
            android:layout_width="48.0dp"
            android:layout_height="48.0dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/Close"
            android:scaleType="centerInside"
            android:src="?android:attr/homeAsUpIndicator"
            android:tint="@color/settings_text_primary" />

        <TextView
            android:id="@+id/aboutHeaderTitleText"
            android:layout_width="0.0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8.0dp"
            android:layout_weight="1.0"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/settings_text_primary"
            android:textSize="20.0sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1.0dp"
        android:background="@color/settings_divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0.0dp"
        android:layout_weight="1.0"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="28.0dp"
                android:paddingBottom="24.0dp">

                <ImageView
                    android:id="@+id/aboutAppIcon"
                    android:layout_width="64.0dp"
                    android:layout_height="64.0dp"
                    android:src="@drawable/icon" />

                <TextView
                    android:id="@+id/aboutAppNameText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12.0dp"
                    android:text="@string/app_name"
                    android:textColor="@color/settings_text_primary"
                    android:textSize="20.0sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1.0dp"
                android:background="@color/settings_divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="56.0dp"
                android:orientation="horizontal"
                android:paddingLeft="16.0dp"
                android:paddingRight="16.0dp">

                <TextView
                    android:layout_width="0.0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0"
                    android:text="@string/Version_Name"
                    android:textColor="@color/settings_text_primary"
                    android:textSize="17.0sp" />

                <TextView
                    android:id="@+id/aboutVersionNameValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/settings_text_secondary"
                    android:textSize="16.0sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1.0dp"
                android:background="@color/settings_divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="56.0dp"
                android:orientation="horizontal"
                android:paddingLeft="16.0dp"
                android:paddingRight="16.0dp">

                <TextView
                    android:layout_width="0.0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0"
                    android:text="@string/Version_Code"
                    android:textColor="@color/settings_text_primary"
                    android:textSize="17.0sp" />

                <TextView
                    android:id="@+id/aboutVersionCodeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/settings_text_secondary"
                    android:textSize="16.0sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1.0dp"
                android:background="@color/settings_divider" />

            <LinearLayout
                android:id="@+id/aboutGithubRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="64.0dp"
                android:orientation="vertical"
                android:paddingLeft="16.0dp"
                android:paddingTop="12.0dp"
                android:paddingRight="16.0dp"
                android:paddingBottom="12.0dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/GitHub"
                    android:textColor="@color/settings_text_primary"
                    android:textSize="17.0sp" />

                <TextView
                    android:id="@+id/aboutGithubUrlText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4.0dp"
                    android:text="@string/github_url"
                    android:textColor="@color/settings_accent"
                    android:textSize="14.0sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1.0dp"
                android:background="@color/settings_divider" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
