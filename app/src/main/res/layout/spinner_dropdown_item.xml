<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minWidth="200.0dp"
    android:minHeight="48.0dp"
    android:orientation="horizontal"
    android:paddingLeft="18.0dp"
    android:paddingRight="16.0dp">

    <TextView
        android:id="@android:id/text1"
        android:layout_width="0.0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.0"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/settings_text_primary"
        android:textSize="16.0sp" />

    <TextView
        android:id="@+id/spinnerDropdownCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14.0dp"
        android:text="✓"
        android:textColor="@color/settings_accent"
        android:textSize="17.0sp"
        android:textStyle="bold" />
</LinearLayout>
