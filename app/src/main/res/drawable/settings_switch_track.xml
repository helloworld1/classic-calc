<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/settings_switch_track_on" />
            <corners android:radius="14.0dp" />
            <size
                android:width="52.0dp"
                android:height="28.0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/settings_switch_track_off" />
            <stroke
                android:width="1.5dp"
                android:color="@color/settings_switch_track_off_stroke" />
            <corners android:radius="14.0dp" />
            <size
                android:width="52.0dp"
                android:height="28.0dp" />
        </shape>
    </item>
</selector>
